rules_version = '2';

// Aturan keamanan Cloud Firestore untuk GeoMatch.
// Salin seluruh isi berkas ini ke Firebase Console > Firestore Database > Rules, lalu klik Publish.
//
// Prinsip:
// - Siswa hanya dapat membaca dan menulis datanya sendiri.
// - Guru (akun yang memiliki dokumen teachers/{uid}) dapat membaca data semua siswa.
// - Dokumen teachers hanya dapat dibuat oleh admin melalui Firebase Console, tidak dari website.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isTeacher() {
      return signedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    // Profil siswa
    match /users/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create, update: if isOwner(uid)
        && request.resource.data.role == 'siswa'
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.kelas is string
        && request.resource.data.kelas.size() <= 30;
      allow delete: if isTeacher();
    }

    // Progres belajar siswa
    match /progress/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() < 200000;
      allow delete: if isTeacher();
    }

    // Penanda akun guru: hanya dapat dibaca oleh guru itu sendiri, tidak dapat ditulis dari website.
    match /teachers/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }
  }
}
